+    # base 0 so CMake can pass the partition size through as "0x5b0000" unchanged.
+    parser.add_argument('--max_size', type=lambda v: int(v, 0), default=0,
+                        help='Fail if the generated image exceeds this many bytes '
+                             '(the assets partition size). 0 disables the check.')
