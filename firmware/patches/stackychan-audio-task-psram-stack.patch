diff --git a/main/audio/processors/afe_audio_processor.cc b/main/audio/processors/afe_audio_processor.cc
index 15e9cc5..7676e8a 100644
--- a/main/audio/processors/afe_audio_processor.cc
+++ b/main/audio/processors/afe_audio_processor.cc
@@ -1,5 +1,6 @@
 #include "afe_audio_processor.h"
 #include <esp_log.h>
+#include <esp_heap_caps.h>
 
 #define PROCESSOR_RUNNING 0x01
 
@@ -66,18 +67,40 @@ void AfeAudioProcessor::Initialize(AudioCodec* codec, int frame_duration_ms, srm
 
     afe_iface_ = esp_afe_handle_from_config(afe_config);
     afe_data_ = afe_iface_->create_from_config(afe_config);
-    
-    xTaskCreate([](void* arg) {
+
+    // StackyChan fork: this task's stack used to come from the default (internal SRAM)
+    // heap via plain xTaskCreate, with the return value unchecked. By the time this runs
+    // -- the first time the device actually starts listening, with the wake-word AFE
+    // instance, WiFi/MQTT and everything else already resident -- internal SRAM can be
+    // tight enough that the allocation silently fails: the task never starts, nothing
+    // ever drains the feed ring buffer, and it floods "AFE(FEED) is full" forever with no
+    // other sign anything is wrong. Same failure mode already hit the wake-word task
+    // (see stackychan-prefer-wakenet.patch / stackychan-wakeword-select.patch); this
+    // moves the stack to PSRAM (8 MB, not the scarce ~26 KB internal pool) the same way
+    // EncodeWakeWordData() already does in afe_wake_word.cc, so it can't happen here.
+    const size_t stack_size = 4096;
+    audio_processor_task_stack_ = (StackType_t*)heap_caps_malloc(stack_size, MALLOC_CAP_SPIRAM);
+    assert(audio_processor_task_stack_ != nullptr);
+    audio_processor_task_buffer_ = (StaticTask_t*)heap_caps_malloc(sizeof(StaticTask_t), MALLOC_CAP_INTERNAL);
+    assert(audio_processor_task_buffer_ != nullptr);
+
+    audio_processor_task_ = xTaskCreateStatic([](void* arg) {
         auto this_ = (AfeAudioProcessor*)arg;
         this_->AudioProcessorTask();
         vTaskDelete(NULL);
-    }, "audio_communication", 4096, this, 3, NULL);
+    }, "audio_communication", stack_size, this, 3, audio_processor_task_stack_, audio_processor_task_buffer_);
 }
 
 AfeAudioProcessor::~AfeAudioProcessor() {
     if (afe_data_ != nullptr) {
         afe_iface_->destroy(afe_data_);
     }
+    if (audio_processor_task_stack_ != nullptr) {
+        heap_caps_free(audio_processor_task_stack_);
+    }
+    if (audio_processor_task_buffer_ != nullptr) {
+        heap_caps_free(audio_processor_task_buffer_);
+    }
     vEventGroupDelete(event_group_);
 }
 
